generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. 사용자 (선수)
model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  email     String?  @unique
  ntrp      Float? // 테니스 실력 지수 (예: 3.5)
  createdAt DateTime @default(now())

  // 관계 설정 (내가 참여한 경기들)
  player1Matches Match[] @relation("Player1")
  player2Matches Match[] @relation("Player2")
  wonMatches     Match[] @relation("Winner")

  notices               ClubNotice[]
  matchRecordsAsPlayer1 MatchRecord[]      @relation("MatchPlayer1")
  matchRecordsAsPlayer2 MatchRecord[]      @relation("MatchPlayer2")
  tournamentPlayers     TournamentPlayer[]
}

// 2. 경기 전적
model Match {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  matchType String // "SINGLES" (단식) 또는 "DOUBLES" (복식)
  courtName String? // 테니스장 이름

  // 단식 기준 선수 연동
  player1Id String
  player1   User   @relation("Player1", fields: [player1Id], references: [id])

  player2Id String
  player2   User   @relation("Player2", fields: [player2Id], references: [id])

  // 경기 결과
  winnerId String
  winner   User   @relation("Winner", fields: [winnerId], references: [id])

  score     String // 세트 스코어 (예: "6-4, 3-6, 10-8")
  memo      String? // 경기 일기/메모
  createdAt DateTime @default(now())
}

model Club {
  id           String   @id @default(cuid())
  name         String
  address      String
  city         String
  description  String
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())

  notices      ClubNotice[]
  merchandises Merchandise[]
  matchRecords MatchRecord[]
  tournaments  MonthlyTournament[]
  members      ClubMember[]
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  userEmail String?
  role      String   @default("MEMBER") // OWNER, MANAGER, MEMBER
  status    String   @default("APPROVED") // APPROVED (자동 승인)
  joinedAt  DateTime @default(now())

  @@unique([clubId, userName])
}

model ClubNotice {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  title       String
  content     String
  isImportant Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Merchandise {
  id          String             @id @default(cuid())
  clubId      String
  club        Club               @relation(fields: [clubId], references: [id])
  name        String             // 상품명 (예: 2026 봄 시즌 단체 카라티)
  description String?            // 상품 설명 및 안내사항
  price       Int                // 예상 가격 (원)
  imageUrl    String?            // 이미지 URL
  colors      String[]           // 선택 가능 색상 목록 (예: ["화이트", "네이비"])
  sizes       String[]           // 선택 가능 사이즈 목록 (예: ["95(M)", "100(L)", "105(XL)"])
  status      String             @default("OPEN") // OPEN(수요조사중), CLOSED(마감)
  createdAt   DateTime           @default(now())
  orders      MerchandiseOrder[]
}

model MerchandiseOrder {
  id            String      @id @default(cuid())
  merchandiseId String
  merchandise   Merchandise @relation(fields: [merchandiseId], references: [id], onDelete: Cascade)
  userId        String
  userName      String?     // 신청자 이름/닉네임
  selectedColor String      // 선택한 색상
  selectedSize  String      // 선택한 사이즈
  quantity      Int         @default(1) // 수량
  createdAt     DateTime    @default(now())
}

model MatchRecord {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  matchType     String   @default("DOUBLE")
  player1Id     String?
  player1       User?    @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player2Id     String?
  player2       User?    @relation("MatchPlayer2", fields: [player2Id], references: [id])
  opponent1Name String?
  opponent2Name String?
  score         String?
  isWin         Boolean?
  matchDate     DateTime @default(now())
}

model MonthlyTournament {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  title     String
  eventDate DateTime
  status    String   @default("UPCOMING")
  createdAt DateTime @default(now())

  groups TournamentGroup[]
}

model TournamentGroup {
  id           String            @id @default(cuid())
  tournamentId String
  tournament   MonthlyTournament @relation(fields: [tournamentId], references: [id])
  groupName    String
  createdAt    DateTime          @default(now())

  players TournamentPlayer[]
  matches TournamentMatch[]
}

model TournamentPlayer {
  id          String          @id @default(cuid())
  groupId     String
  group       TournamentGroup @relation(fields: [groupId], references: [id])
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  displayName String
  createdAt   DateTime        @default(now())
}

model TournamentMatch {
  id             String          @id @default(cuid())
  groupId        String
  group          TournamentGroup @relation(fields: [groupId], references: [id])
  team1Player1Id String?
  team1Player2Id String?
  team2Player1Id String?
  team2Player2Id String?
  team1Score     Int?
  team2Score     Int?
  isCompleted    Boolean         @default(false)
  createdAt      DateTime        @default(now())
}
